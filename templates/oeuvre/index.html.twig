{% extends 'base.html.twig' %}
{% block title %}Toutes les oeuvres{% endblock %}

{% block body %}

<h1>La liste des oeuvres</h1>

{% if oeuvres is empty %}
    <p>Aucune oeuvre trouvée</p>
{% else %}
    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date de sortie</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for oeuvre in oeuvres %}
                <tr>
                    <td>{{ oeuvre.titre }}</td>
                    <td>{{ oeuvre.dateSortie | date('d/m/Y H:i:s') }}</td>
                    <td>
                        <form action="{{ path('oeuvre_modification', {'id': oeuvre.id}) }}">
                            <button type="submit">Modifier</button>
                        </form>
                         <form action="{{ path('oeuvre_suppression', {'id': oeuvre.id}) }}">
                            <button type="submit">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
{% endblock %}
